# ==============================================================================
# VARIABLES DE ENTORNO - APP HUEVOS
# Copia este archivo como .env.local y completa los valores con tus credenciales:
# cp .env.example .env.local
# ==============================================================================

# Supabase Project URL (Dashboard > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Anon Key (Dashboard > Project Settings > API > Project API Keys > anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Supabase Service Role Key (Dashboard > Project Settings > API > service_role)
# Necesario para tareas administrativas (crear/borrar usuarios, backups)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Clave de Licencia (opcional para desarrollo local)
NEXT_PUBLIC_LICENSE_KEY=DEV_LICENSE
NEXT_PUBLIC_MASTER_LICENSE_SERVER_URL=
